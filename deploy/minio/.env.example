# MinIO root-учётка (админ хранилища). Задать сильные значения.
MINIO_ROOT_USER=enb_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password_here

# Публичный S3-эндпоинт (через nginx VM1). Меняется вместе с поддоменом.
MINIO_SERVER_URL=https://s3.edunabazar.ru
MINIO_BROWSER_REDIRECT_URL=https://s3.edunabazar.ru/minio-console/

# Разрешённые origin'ы для CORS (браузерная загрузка частей). Через запятую.
MINIO_API_CORS_ALLOW_ORIGIN=https://edunabazar.ru,https://www.edunabazar.ru
