# GlitchTip configuration — скопировать в .env рядом и заполнить.

# PostgreSQL на VM2. База и роль создаются вручную, см. README.md.
DATABASE_URL=postgres://glitchtip:CHANGE-ME@10.0.0.11:5432/glitchtip

# Длинный случайный ключ (например: openssl rand -hex 32)
SECRET_KEY=CHANGE-ME

# SMTP для писем об ошибках (тот же Yandex Cloud Postbox, что у приложения).
# Формат: smtp+tls://<user>:<password>@<host>:<port>
EMAIL_URL=smtp+tls://API-KEY-ID:API-KEY-SECRET@postbox.cloud.yandex.net:587
DEFAULT_FROM_EMAIL=noreply@edunabazar.ru

# Публичный URL инсталляции (используется в письмах и DSN)
GLITCHTIP_DOMAIN=https://errors.edunabazar.ru
